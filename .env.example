DATABASE_URL=
DATABASE_URL_POOLED=
AUTH_SECRET=
AUTH_URL=
NEXT_PUBLIC_APP_URL=

# Enable external object storage (recommended for videos / large files)
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_FORCE_PATH_STYLE=1
UPLOAD_EXTERNAL_REQUIRED_MB=200

# Optional: only used for DB chunked fallback
UPLOAD_CHUNK_MB=4

# Email Service (Resend)
RESEND_API_KEY=
RESEND_FROM=
# Protect /api/cron/payment-emails. Use a random server-only secret of at least 32 characters.
# Schedule this endpoint every 5 minutes with Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
SMTP_FROM=

# اختياري لتوقيع إشعارات الدفع؛ عند غيابه يُتحقق مباشرة عبر مفاتيح API.
STREAM_WEBHOOK_SECRET=
# مفتاح خاص للتذاكر بطول 32 حرفاً على الأقل؛ عند غيابه يُستخدم AUTH_SECRET القوي.
# لا تستخدم NEXT_PUBLIC_ لهذا المفتاح، ويجب توحيده بين جميع نسخ السيرفر.
EVENT_TICKET_SECRET=

# Apple Wallet: base64-encoded PEM certificates/key, server-side only.
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_SIGNER_CERT_BASE64=
APPLE_WALLET_SIGNER_KEY_BASE64=
APPLE_WALLET_WWDR_CERT_BASE64=
APPLE_WALLET_SIGNER_KEY_PASSPHRASE=
